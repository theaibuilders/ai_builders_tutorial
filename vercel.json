{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "services/frontend",
      "buildCommand": "npm run build && find .vercel/output/functions -name '.vc-config.json' -exec sed -i 's/nodejs18[.]x/nodejs24.x/g' {} +"
    },
    "backend": {
      "root": "services/backend",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
