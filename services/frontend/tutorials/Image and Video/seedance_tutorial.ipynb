        "def generate_with_retry(model, content, filename=\"output.mp4\", max_retries=3, verbose=True):\n",
        "    \"\"\"\n",
        "    Generate video with automatic retry on failure.\n",
        "    \n",
        "    Args:\n",
        "        model: Model ID string\n",
        "        content: List of content dicts (text/image_url)\n",
        "        filename: Output filename\n",
        "        max_retries: Maximum number of retry attempts\n",
        "        verbose: Print progress\n",
        "    \n",
        "    Returns:\n",
        "        Local path to downloaded video or None on failure\n",
        "    \"\"\"\n",
        "    for attempt in range(max_retries):\n",
        "        try:\n",
        "            if attempt > 0:\n",
        "                print(f\"\\n🔄 Retry attempt {attempt + 1}/{max_retries}\")\n",
        "            \n",
        "            video_path = generate_video(model, content, filename, verbose)\n",
        "            if video_path:\n",
        "                return video_path\n",
        "                \n",
        "        except Exception as e:\n",
        "            print(f\"❌ Attempt {attempt + 1} failed: {e}\")\n",
        "            if attempt < max_retries - 1:\n",
        "                wait_time = 5 * (attempt + 1)\n",
        "                print(f\"⏳ Waiting {wait_time}s before retry...\")\n",
        "                time.sleep(wait_time)\n",
        "    \n",
        "    return None\n",
        "\n",
        "print(\"✅ generate_with_retry() defined\")"
      ]
    },
