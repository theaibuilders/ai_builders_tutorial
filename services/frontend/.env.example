# Frontend Environment Variables

# Google OAuth Client ID
# For development: Create a separate OAuth client ID in Google Cloud Console
# and add http://localhost:4321 as an authorized origin
# For production: Use the production client ID
PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# API URL (backend)
PUBLIC_API_URL=http://localhost:8000
PUBLIC_BACKEND_URL=http://localhost:8000
